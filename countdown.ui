     <string notr="true">QLineEdit {
        background-color: #F3E5F5;   
        border: 2px solid #C8A2C8;   /* یاسی ملایم */
        border-radius: 8px;
        padding: 6px;
        font-size: 14px;
        color: #4A235A;              /* بنفش تیره برای نوشته */
